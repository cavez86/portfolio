{
  "i18n-ally.keystyle": "nested",
  "i18n-ally.localesPaths": ["./messages"],
  "tailwindCSS.classAttributes": ["class", "className", "ngClass", ".*Styles.*", ".*Classes.*"],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(((?:[^()]|\\([^()]*\\))*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(((?:[^()]|\\([^()]*\\))*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ]
}
